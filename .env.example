# Copy this file to .env and fill in values.
# Leave USE_SUPABASE=false to run fully local on SQLite (default).
# Set it to true and provide the keys to use Supabase (Postgres + Storage + Auth).

USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (defaults in backend/config.py)
# MAX_UPLOAD_MB=512
# MAX_FRAMES_ON_DISK=1500
# DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
